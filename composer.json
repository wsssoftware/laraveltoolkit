{
  "name": "wsssoftware/laraveltoolkit",
  "description": "A modern toolkit of components and utilities for Laravel applications, developed by WSS Software.",
  "keywords": [
    "wsssoftware",
    "laravel",
    "laraveltoolkit"
  ],
  "homepage": "https://github.com/wsssoftware/laraveltoolkit",
  "license": "MIT",
  "authors": [
    {
      "name": "Allan Mariucci Carvalho",
      "email": "allan@wsssoftware.com.br",
      "role": "Developer"
    }
  ],
  "require": {
    "php": "^8.4",
    "ext-bcmath": "*",
    "ext-dom": "*",
    "ext-intl": "*",
    "czproject/git-php": "^4.3",
    "illuminate/contracts": "^11.30||^12.0",
    "inertiajs/inertia-laravel": "^2.0.1",
    "jaybizzle/crawler-detect": "^1.3",
    "spatie/laravel-package-tools": "^1.16"
  },
  "require-dev": {
    "laravel/pint": "^1.14",
    "nunomaduro/collision": "^8.1.1",
    "orchestra/testbench": "^10.0.0||^9.0.0",
    "pestphp/pest": "^4.0",
    "pestphp/pest-plugin-arch": "^4.0",
    "pestphp/pest-plugin-laravel": "^4.0",
    "spatie/laravel-ray": "^1.35"
  },
  "autoload": {
    "files": [
      "src/helpers.php"
    ],
    "psr-4": {
      "Laraveltoolkit\\": "src/",
      "Laraveltoolkit\\Database\\Factories\\": "database/factories/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Laraveltoolkit\\Tests\\": "tests/",
      "Workbench\\App\\": "workbench/app/"
    }
  },
  "scripts": {
    "post-autoload-dump": "@composer run prepare",
    "prepare": "@php vendor/bin/testbench package:discover --ansi",
    "analyse": "vendor/bin/phpstan analyse",
    "test": "vendor/bin/pest",
    "test-dirty": "vendor/bin/pest --dirty",
    "test-coverage": "vendor/bin/pest --coverage",
    "format": "vendor/bin/pint"
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "pestphp/pest-plugin": true,
      "phpstan/extension-installer": true
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Laraveltoolkit\\LaraveltoolkitServiceProvider"
      ],
      "aliases": {
        "Laraveltoolkit": "Laraveltoolkit\\Facades\\Laraveltoolkit"
      }
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
